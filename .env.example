# Copy to .env and fill in. Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_PASSWORD=change-me

# Optional: Google sign-in (OAuth "Web application" client ID; add your site URL as an authorised JS origin)
GOOGLE_CLIENT_ID=

# Where the browser reaches the API, and which site origin(s) the API accepts
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=10
